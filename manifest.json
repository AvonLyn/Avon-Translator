{
  "manifest_version": 3,
  "name": "Avon Translator 翻译助手",
  "version": "0.1.1",
  "description": "划词快捷翻译，单词音标显示，历史与生词本复习。",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "contentScript.js"
      ],
      "css": [
        "contentStyles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "translate-selection": {
      "description": "翻译当前选中文本",
      "suggested_key": {
        "default": "Ctrl+Shift+L"
      }
    }
  },
  "action": {
    "default_title": "Avon Translator 翻译助手",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
